/**
 * Custom Styles here.
 *
 * ref：https://v1.vuepress.vuejs.org/config/#index-styl
 */

.home .hero img
  max-width 400px!important

// Scoped to the Open Call page; other pages retain their existing appearance.
.snowcop-open-call
  h1
    color #df1b12

  .call-status
    margin 1.5rem 0
    padding 1rem 1.25rem
    border-left 4px solid #df1b12
    border-radius 0 6px 6px 0
    background #fff4f1

    p
      margin 0.4rem 0

  .call-contact
    display inline-block
    padding 0.7rem 1rem
    border 2px solid #df1b12
    border-radius 5px
    color #b4160e
    font-weight 600

    &:hover
      background #fff4f1
      text-decoration none!important

    &:focus-visible
      outline 3px solid #2c3e50
      outline-offset 3px

  a
    overflow-wrap anywhere

  @media (max-width: 600px)
    .call-contact
      display block
      text-align center
